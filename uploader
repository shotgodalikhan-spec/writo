(async function (prefix, message) {
  const names = Object.keys(localStorage).filter(k => k.startsWith("wu:" + prefix) && !k.slice(3 + prefix.length).includes("/"));
  const dt = new DataTransfer();
  for (const k of names) {
    const v = localStorage.getItem(k);
    let blob;
    if (v.startsWith("data:")) { const bin = atob(v.split(",")[1]); const a = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++) a[i] = bin.charCodeAt(i); blob = new Blob([a], { type: "image/png" }); } else { blob = new Blob([new TextEncoder().encode(v)]); }
    dt.items.add(new File([blob], k.slice(3 + prefix.length)));
  }
  const inp = document.querySelector("input[type=file]");
  inp.files = dt.files; inp.dispatchEvent(new Event("change", { bubbles: true }));
  const want = names.length;
  for (let i = 0; i < 90; i++) {
    await new Promise(r => setTimeout(r, 1000));
    const entries = [...document.querySelectorAll(".js-manifest-file-entry")].filter(e => e.textContent.trim());
    const busy = document.querySelector(".is-uploading, .js-upload-progress:not([hidden]), [data-upload-state='uploading']");
    const btn = [...document.querySelectorAll("button[type=submit]")].find(b => /Commit changes/.test(b.textContent));
    if (entries.length >= want && !busy && btn && !btn.disabled) {
      await new Promise(r => setTimeout(r, 2500));
      const msg = document.querySelector("#commit-summary-input, input[name='message']");
      msg.value = message; msg.dispatchEvent(new Event("input", { bubbles: true }));
      window.__committing = true;
      setTimeout(() => btn.click(), 100);
      return { ok: true, files: names.map(n => n.slice(3 + prefix.length)), waited: i + 1 };
    }
  }
  return { ok: false, reason: "upload did not finish" };
})